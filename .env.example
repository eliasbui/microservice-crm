# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================
# GENERAL
# ============================================
ENVIRONMENT=development
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# DATABASE - PostgreSQL
# ============================================
# Master Database
POSTGRES_HOST=postgres-master
POSTGRES_PORT=5432
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change_me_in_production

# Slave Database (Read Replica)
POSTGRES_SLAVE_HOST=postgres-slave
POSTGRES_SLAVE_PORT=5432

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# DATABASE - MongoDB
# ============================================
MONGODB_USER=crm_user
MONGODB_PASSWORD=change_me_in_production
MONGODB_DATABASE=crm_db
MONGODB_URI=mongodb://crm_user:change_me_in_production@mongodb-primary:27017,mongodb-secondary1:27017,mongodb-secondary2:27017/crm_db?replicaSet=rs0&authSource=admin

# ============================================
# DATABASE - Cassandra
# ============================================
CASSANDRA_CONTACT_POINTS=cassandra-1,cassandra-2,cassandra-3
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=crm_keyspace
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra
CASSANDRA_DATACENTER=datacenter1

# ============================================
# DATABASE - MySQL
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=crm_notifications
MYSQL_USER=crm_user
MYSQL_PASSWORD=change_me_in_production
MYSQL_ROOT_PASSWORD=change_me_in_production

# ============================================
# DATABASE - MariaDB
# ============================================
MARIADB_HOST=mariadb
MARIADB_PORT=3307
MARIADB_DATABASE=crm_integrations
MARIADB_USER=crm_user
MARIADB_PASSWORD=change_me_in_production
MARIADB_ROOT_PASSWORD=change_me_in_production

# ============================================
# DATABASE - CouchDB
# ============================================
COUCHDB_HOST=couchdb
COUCHDB_PORT=5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=change_me_in_production
COUCHDB_URL=http://admin:change_me_in_production@couchdb:5984

# ============================================
# REDIS - Caching
# ============================================
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_NODES=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_PASSWORD=change_me_in_production
REDIS_DB=0

# ============================================
# RABBITMQ - Message Broker
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=crm_user
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=/crm
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# KAFKA - Event Streaming
# ============================================
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_GROUP_ID=crm-services
KAFKA_CLIENT_ID=crm-client
KAFKA_TOPICS_PREFIX=crm

# ============================================
# AUTH SERVICE (C#/.NET)
# ============================================
AUTH_SERVICE_PORT=5001
AUTH_SERVICE_HOST=auth-service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ISSUER=crm-auth-service
JWT_AUDIENCE=crm-api
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# OAuth 2.0
OAUTH_CLIENT_ID=crm-client
OAUTH_CLIENT_SECRET=change_me_in_production
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Identity Server
IDENTITY_SERVER_URL=http://localhost:5001
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=crm

# ============================================
# CRM CORE SERVICE (Java/Spring Boot)
# ============================================
CRM_SERVICE_PORT=8081
CRM_SERVICE_HOST=crm-core-service

# Spring Boot
SPRING_PROFILES_ACTIVE=development
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/crm_db
SPRING_DATASOURCE_USERNAME=crm_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ============================================
# CHAT & AI SERVICE (Golang)
# ============================================
CHAT_SERVICE_PORT=8082
CHAT_SERVICE_HOST=chat-ai-service

# AI Provider (claude or openai)
AI_PROVIDER=claude
CLAUDE_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
AI_MODEL_CLAUDE=claude-3-5-sonnet-20241022
AI_MODEL_OPENAI=gpt-4-turbo-preview

# WebSocket
WEBSOCKET_PORT=8082
WEBSOCKET_PATH=/ws

# ============================================
# AUTOMATION SERVICE (Rust)
# ============================================
AUTOMATION_SERVICE_PORT=8083
AUTOMATION_SERVICE_HOST=automation-service

# Workflow Configuration
WORKFLOW_EXECUTOR_THREADS=4
WORKFLOW_MAX_CONCURRENT_TASKS=100

# ============================================
# NOTIFICATION SERVICE (BUN)
# ============================================
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_HOST=notification-service

# Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@yourcompany.com
EMAIL_FROM_NAME=CRM System

# SMTP Configuration (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=true

# SMS Configuration (SOAP Gateway)
SMS_GATEWAY_URL=http://sms-gateway:8080/soap
SMS_GATEWAY_USERNAME=sms_user
SMS_GATEWAY_PASSWORD=change_me_in_production

# Push Notifications
FCM_SERVER_KEY=your-firebase-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-team-id

# ============================================
# ANALYTICS SERVICE (Java)
# ============================================
ANALYTICS_SERVICE_PORT=8085
ANALYTICS_SERVICE_HOST=analytics-service

# Data Warehouse
DWH_TYPE=snowflake  # or bigquery
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=analytics_user
SNOWFLAKE_PASSWORD=change_me_in_production
SNOWFLAKE_DATABASE=CRM_ANALYTICS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# BigQuery (Alternative)
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_DATASET=crm_analytics
BIGQUERY_CREDENTIALS_PATH=/secrets/bigquery-credentials.json

# ============================================
# INTEGRATION SERVICE (Golang)
# ============================================
INTEGRATION_SERVICE_PORT=8086
INTEGRATION_SERVICE_HOST=integration-service

# ERP Integration
ERP_API_URL=http://erp-system:8080/api
ERP_API_KEY=your-erp-api-key
ERP_TIMEOUT_SECONDS=30

# Email Marketing Integration
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_SERVER_PREFIX=us1

# Accounting Integration
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=http://localhost:8086/callback/quickbooks

# ============================================
# API GATEWAY (Nginx)
# ============================================
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=api-gateway

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================
# FRONTEND (Next.js)
# ============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8082
NEXT_PUBLIC_APP_NAME=CRM System
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================
# MONITORING - Prometheus
# ============================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=15

# ============================================
# MONITORING - Grafana
# ============================================
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# ============================================
# LOGGING - Elasticsearch
# ============================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change_me_in_production

# ============================================
# LOGGING - Kibana
# ============================================
KIBANA_PORT=5601
KIBANA_ELASTICSEARCH_URL=http://elasticsearch:9200

# ============================================
# LOGGING - Logstash
# ============================================
LOGSTASH_PORT=5000
LOGSTASH_BEATS_PORT=5044

# ============================================
# SECURITY - HashiCorp Vault
# ============================================
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=your-vault-root-token
VAULT_SKIP_VERIFY=true

# ============================================
# KUBERNETES
# ============================================
K8S_NAMESPACE=crm-system
K8S_CLUSTER_NAME=crm-cluster

# ============================================
# HELM
# ============================================
HELM_RELEASE_NAME=crm-system
HELM_CHART_VERSION=1.0.0

# ============================================
# CI/CD
# ============================================
DOCKER_REGISTRY=ghcr.io
DOCKER_REGISTRY_USER=your-github-username
DOCKER_REGISTRY_TOKEN=your-github-token
IMAGE_TAG=latest

# ============================================
# EXTERNAL SERVICES
# ============================================
# Twilio (Alternative SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (Payment Integration)
STRIPE_API_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# AWS Services (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=crm-attachments

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_CHAT_ENABLED=true
FEATURE_EMAIL_MARKETING_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_AUTOMATION_ENABLED=true
FEATURE_DARK_MODE_ENABLED=true

# ============================================
# PERFORMANCE
# ============================================
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
MAX_FILE_UPLOAD_SIZE_MB=10
