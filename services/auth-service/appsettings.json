{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_HOST:localhost};Port=${POSTGRES_PORT:5432};Database=${POSTGRES_DB:crm_db};Username=${POSTGRES_USER:crm_user};Password=${POSTGRES_PASSWORD:password}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET:your-super-secret-jwt-key-change-in-production-min-32-chars}",
    "Issuer": "${JWT_ISSUER:crm-auth-service}",
    "Audience": "${JWT_AUDIENCE:crm-api}",
    "ExpirationMinutes": "${JWT_EXPIRATION_MINUTES:60}"
  },
  "Redis": {
    "Configuration": "${REDIS_SENTINEL_MASTER:localhost:6379}"
  },
  "Elasticsearch": {
    "Uri": "${ELASTICSEARCH_HOST:http://elasticsearch:9200}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
